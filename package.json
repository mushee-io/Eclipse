{
  "name": "eclipse-protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Eclipse — Zero-Disclosure Prize Savings on Zama FHEVM",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf artifacts cache coverage types",
    "compile": "hardhat compile",
    "test": "hardhat test",
    "test:sepolia": "hardhat test --network sepolia",
    "typecheck": "tsc --noEmit",
    "format": "prettier --plugin=prettier-plugin-solidity --write \"**/*.{json,md,sol,ts,yml}\"",
    "format:check": "prettier --plugin=prettier-plugin-solidity --check \"**/*.{json,md,sol,ts,yml}\"",
    "deploy:sepolia": "hardhat run scripts/deploy.ts --network sepolia",
    "check:sepolia": "hardhat run scripts/sepolia/check-env.ts --network sepolia",
    "deploy:sepolia:probe": "hardhat run scripts/sepolia/deploy-probe.ts --network sepolia",
    "deploy:sepolia:vault": "node scripts/sepolia/deploy-vault.mjs",
    "deposit:sepolia:vault": "node scripts/sepolia/deposit-vault.mjs",
    "decrypt:sepolia:vault": "node scripts/sepolia/decrypt-vault.mjs",
    "migrate:sepolia:vault": "node scripts/sepolia/migrate-bootstrap-vault.mjs",
    "deploy:sepolia:draw-system": "node scripts/sepolia/deploy-draw-system.mjs",
    "deploy:local": "hardhat run scripts/deployLocal.ts"
  },
  "dependencies": {
    "@fhevm/solidity": "0.11.1",
    "@openzeppelin/confidential-contracts": "0.5.3",
    "@openzeppelin/contracts": "5.6.1",
    "@zama-fhe/relayer-sdk": "0.4.1"
  },
  "devDependencies": {
    "@fhevm/hardhat-plugin": "0.4.2",
    "@fhevm/mock-utils": "0.4.2",
    "@nomicfoundation/hardhat-chai-matchers": "2.1.0",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@nomicfoundation/hardhat-network-helpers": "1.1.0",
    "@nomicfoundation/hardhat-verify": "2.1.0",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "20.19.8",
    "chai": "4.5.0",
    "dotenv": "16.6.1",
    "ethers": "6.16.0",
    "hardhat": "2.29.1",
    "prettier": "3.6.2",
    "prettier-plugin-solidity": "2.1.0",
    "rimraf": "6.0.1",
    "solidity-coverage": "0.8.16",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.8.3"
  }
}
